# Postgres Neon (prod / preview). Laisser vide en local : PGlite est utilisé (.data/pglite).
DATABASE_URL=
# Secret de signature des cookies (32+ caractères aléatoires). Obligatoire en prod.
SESSION_SECRET=
# Mot de passe partagé des organisateurs (/admin). 20+ caractères en prod.
ADMIN_PASSWORD=
# Code du lien secret d'accès à l'orga : https://<site>/rejoindre/<GROUP_ACCESS_CODE>
GROUP_ACCESS_CODE=
